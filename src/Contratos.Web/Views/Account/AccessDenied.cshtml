@{
    ViewData["Title"] = "Acesso Restrito (RBAC)";
}

<div class="corp-card p-5 text-center my-4 mx-auto" style="max-width: 620px;">
    <div class="mb-3">
        <span class="d-inline-flex align-items-center justify-content-center rounded-circle"
              style="width: 72px; height: 72px; background-color: rgba(182,70,46,0.14); color: var(--color-terracotta-red); font-size: 2rem;">
            <i class="bi bi-shield-lock-fill"></i>
        </span>
    </div>
    <h4 class="fw-bold mb-2" style="color: var(--color-deep-teal);">Acesso Não Autorizado pelo Controle RBAC</h4>
    <p class="text-muted mb-4">
        Seu perfil atual não possui permissão para executar esta operação ou acessar este módulo restrito.
        Caso necessite de elevação de privilégio, solicite ao Administrador Master.
    </p>
    <a href="@Url.Action("Index", "Home")" class="btn btn-teal px-4">
        <i class="bi bi-arrow-left me-2"></i>Retornar ao Dashboard Executivo
    </a>
</div>
