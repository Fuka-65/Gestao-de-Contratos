@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard Executivo Contratual & Auditoria";
    bool podeGerenciarContratos = User.IsInRole("Master") || User.IsInRole("Financeiro") || User.IsInRole("GestorContratos");
    bool podeGerenciarFinanceiro = User.IsInRole("Master") || User.IsInRole("Financeiro");
}

<!-- 1. Linha de KPIs Estratégicos (Cards Compactos com Borda Colorida e Sem Quebra de Linhas) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card kpi-primary">
            <div class="kpi-content">
                <div class="kpi-label" title="Despesa Total Mensal (@Model.CompetenciaAtualLabel)">Despesa Mensal (@Model.CompetenciaAtualLabel)</div>
                <div class="kpi-value" title="@Model.DespesaTotalMensal.ToString("C2")">@Model.DespesaTotalMensal.ToString("C2")</div>
                <div class="kpi-subtext">@Model.TotalFaturasCompetenciaAtual faturas na competência atual</div>
            </div>
            <div class="kpi-icon-box">
                <i class="bi bi-wallet2"></i>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card kpi-secondary">
            <div class="kpi-content">
                <div class="kpi-label" title="Contratos Vigentes Ativos">Contratos Vigentes Ativos</div>
                <div class="kpi-value">@Model.TotalContratosVigentes Contratos</div>
                <div class="kpi-subtext" title="Global: @Model.ValorGlobalSobGestao.ToString("C2")">Global: @Model.ValorGlobalSobGestao.ToString("C2")</div>
            </div>
            <div class="kpi-icon-box">
                <i class="bi bi-file-earmark-check"></i>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card kpi-warning">
            <div class="kpi-content">
                <div class="kpi-label" title="Alerta de Vencimentos Próximos">Vencimentos Próximos</div>
                <div class="kpi-value" style="color: #b86609;">@Model.TotalContratosProximoVencimento A Vencer</div>
                <div class="kpi-subtext">@Model.TotalContratosRenovacaoAutomaticaCritica c/ renovação automática</div>
            </div>
            <div class="kpi-icon-box">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card kpi-danger">
            <div class="kpi-content">
                <div class="kpi-label" title="Auditoria de Desvios Financeiros">Auditoria de Desvios</div>
                <div class="kpi-value" style="color: var(--color-terracotta-red);">@Model.ValorTotalDesvioMes.ToString("C2")</div>
                <div class="kpi-subtext">@Model.TotalFaturasComDesvioMes faturas com cobrança excedente</div>
            </div>
            <div class="kpi-icon-box">
                <i class="bi bi-shield-exclamation"></i>
            </div>
        </div>
    </div>
</div>

<!-- 1.B Faixa Executiva Contábil: Impostos Apurados, Valor Líquido, OPEX & CAPEX Mensal -->
<div class="corp-card p-3 mb-4" style="border-left: 5px solid var(--color-deep-teal);">
    <div class="row g-3 align-items-center">
        <div class="col-6 col-md-3 border-end">
            <div class="small text-uppercase fw-bold text-secondary">Comprometimento Bruto vs. Líquido</div>
            <div class="fw-bold fs-6" style="color: var(--color-deep-teal);">
                Bruto: @Model.ComprometimentoMensalContratado.ToString("C2")
            </div>
            <div class="small text-muted">Líquido s/ Impostos: <strong>@Model.TotalLiquidoSemImpostosMes.ToString("C2")</strong></div>
        </div>
        <div class="col-6 col-md-3 border-end">
            <div class="small text-uppercase fw-bold text-secondary">Impostos Apurados (Mês)</div>
            <div class="fw-bold fs-6 text-danger">
                <i class="bi bi-bank2 me-1"></i>@Model.TotalImpostosApuradosMes.ToString("C2")
            </div>
            <div class="small text-muted">Tributos retidos/incidentes nos contratos</div>
        </div>
        <div class="col-6 col-md-3 border-end">
            <div class="small text-uppercase fw-bold text-secondary">Segregação OPEX vs. CAPEX</div>
            <div class="fw-bold small" style="color: var(--color-vibrant-teal);">
                OPEX: @Model.TotalOpexMensalAtivo.ToString("C2")
            </div>
            <div class="fw-bold small" style="color: #b86609;">
                CAPEX: @Model.TotalCapexMensalAtivo.ToString("C2")
            </div>
        </div>
        <div class="col-6 col-md-3 text-md-end">
            <a href="@Url.Action("Index", "Orcamento")" class="btn btn-sm btn-teal px-3">
                <i class="bi bi-calculator-fill me-1"></i>Simular Orçamento (1 a N Meses)
            </a>
            <div class="small text-muted mt-1">Anual, Semestral, Trimestral, Bimestral</div>
        </div>
    </div>
</div>

<!-- 2. Seção de Alertas Inteligentes -->
@if (Model.TotalContratosProximoVencimento > 0 || Model.TotalFaturasComDesvioMes > 0 || Model.TotalContratosVencidos > 0)
{
    <div class="row g-3 mb-4">
        @if (Model.TotalContratosProximoVencimento > 0 || Model.TotalContratosVencidos > 0)
        {
            <div class="col-12 col-lg-6">
                <div class="p-3 rounded-3 shadow-sm d-flex align-items-center justify-content-between gap-3 h-100"
                     style="background-color: #fff9f0; border: 1px solid rgba(246, 159, 58, 0.55); border-left: 5px solid var(--color-warm-amber);">
                    <div class="d-flex align-items-center gap-3 min-w-0">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width: 42px; height: 42px; background: rgba(246, 159, 58, 0.22); color: #a85c05; font-size: 1.25rem;">
                            <i class="bi bi-bell-fill"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="fw-bold text-nowrap-ellipsis" style="color: #7d4300;">
                                Prevenção de Renovação Involuntária &amp; Vigência
                            </div>
                            <div class="small text-secondary text-nowrap-ellipsis">
                                <strong>@Model.TotalContratosProximoVencimento</strong> contrato(s) próximo(s) do vencimento e <strong>@Model.TotalContratosVencidos</strong> expirado(s).
                            </div>
                        </div>
                    </div>
                    <a href="@Url.Action("Index", "Contratos", new { filtroAlerta = "vencendo" })"
                       class="btn btn-sm fw-semibold flex-shrink-0"
                       style="background-color: var(--color-warm-amber); color: #191919;">
                        Analisar Prazos <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        }

        @if (Model.TotalFaturasComDesvioMes > 0)
        {
            <div class="col-12 col-lg-6">
                <div class="p-3 rounded-3 shadow-sm d-flex align-items-center justify-content-between gap-3 h-100"
                     style="background-color: #fdf3f1; border: 1px solid rgba(182, 70, 46, 0.45); border-left: 5px solid var(--color-terracotta-red);">
                    <div class="d-flex align-items-center gap-3 min-w-0">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width: 42px; height: 42px; background: rgba(182, 70, 46, 0.18); color: var(--color-terracotta-red); font-size: 1.25rem;">
                            <i class="bi bi-exclamation-octagon-fill"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="fw-bold text-nowrap-ellipsis" style="color: var(--color-terracotta-red);">
                                Desvio Financeiro Detectado na Competência (@Model.CompetenciaAtualLabel)
                            </div>
                            <div class="small text-secondary text-nowrap-ellipsis">
                                <strong>@Model.TotalFaturasComDesvioMes</strong> fatura(s) cobrada(s) acima do contrato (Excesso: <strong>@Model.ValorTotalDesvioMes.ToString("C2")</strong>).
                            </div>
                        </div>
                    </div>
                    <a href="@Url.Action("Index", "Faturas", new { apenasDesvios = true })"
                       class="btn btn-sm text-white fw-semibold flex-shrink-0"
                       style="background-color: var(--color-terracotta-red);">
                        Auditar Glosas <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        }
    </div>
}

<!-- 3. Gráficos Interativos (Chart.js) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-xl-8">
        <div class="corp-card h-100">
            <div class="corp-card-header">
                <h2 class="corp-card-title">
                    <i class="bi bi-bar-chart-line-fill me-2" style="color: var(--color-vibrant-teal);"></i>
                    Evolução de Gastos Contratuais: Valor Homologado vs. Faturado (Últimos 6 Meses)
                </h2>
                <span class="badge badge-teal">Auditoria Mensal BRL</span>
            </div>
            <div class="p-3">
                <div style="position: relative; height: 290px; width: 100%;">
                    <canvas id="chartEvolucaoGastos"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="corp-card h-100">
            <div class="corp-card-header">
                <h2 class="corp-card-title">
                    <i class="bi bi-pie-chart-fill me-2" style="color: var(--color-deep-teal);"></i>
                    Top Fornecedores (Market Share)
                </h2>
                <span class="badge bg-light text-secondary border">Comprometimento</span>
            </div>
            <div class="p-3">
                <div style="position: relative; height: 290px; width: 100%;">
                    <canvas id="chartTopFornecedores"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 4. Tabelas de Acompanhamento Rápido -->
<div class="row g-3">
    <!-- Tabela de Contratos que exigem decisão imediata -->
    <div class="col-12 col-xxl-6">
        <div class="corp-card h-100">
            <div class="corp-card-header">
                <h2 class="corp-card-title">
                    <i class="bi bi-calendar-event me-2" style="color: var(--color-warm-amber);"></i>
                    Contratos que Exigem Tomada de Decisão Imediata
                </h2>
                <a href="@Url.Action("Index", "Contratos")" class="btn btn-sm btn-outline-secondary">
                    Ver Todos
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-corp mb-0">
                    <thead>
                        <tr>
                            <th>Contrato</th>
                            <th>Fornecedor / Objeto</th>
                            <th>Término</th>
                            <th>Prazo</th>
                            <th>Renovação</th>
                            <th class="text-end">Valor Mensal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ContratosAtencaoImediata.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    Nenhum contrato próximo do vencimento na janela atual.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.ContratosAtencaoImediata)
                            {
                                <tr>
                                    <td>
                                        <a href="@Url.Action("Details", "Contratos", new { id = item.Id })" class="fw-bold text-decoration-none" style="color: var(--color-deep-teal);">
                                            @item.NumeroContrato
                                        </a>
                                    </td>
                                    <td title="@item.FornecedorNome - @item.TituloObjeto">
                                        <div class="fw-semibold text-nowrap-ellipsis" style="max-width: 210px;">@item.FornecedorNome</div>
                                        <div class="small text-muted text-nowrap-ellipsis" style="max-width: 210px;">@item.TituloObjeto</div>
                                    </td>
                                    <td>@item.DataTerminoVigencia.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (item.DiasRestantes < 0)
                                        {
                                            <span class="badge badge-terracotta">
                                                Vencido há @Math.Abs(item.DiasRestantes)d
                                            </span>
                                        }
                                        else if (item.DiasRestantes <= 30)
                                        {
                                            <span class="badge badge-amber">
                                                <i class="bi bi-clock-history me-1"></i>@item.DiasRestantes dias
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-teal">@item.DiasRestantes dias</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.RenovaAutomaticamente)
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-dark border border-warning" title="Exige aviso prévio de @item.DiasAvisoPrevioRescisao dias">
                                                Auto (@(item.DiasAvisoPrevioRescisao)d aviso)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border">Manual</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold">@item.ValorMensal.ToString("C2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Tabela de Lançamentos Recentes de Faturas & Auditoria -->
    <div class="col-12 col-xxl-6">
        <div class="corp-card h-100">
            <div class="corp-card-header">
                <h2 class="corp-card-title">
                    <i class="bi bi-shield-check me-2" style="color: var(--color-terracotta-red);"></i>
                    Auditoria Recente de Faturas &amp; Confronto Contratual
                </h2>
                <a href="@Url.Action("Index", "Faturas")" class="btn btn-sm btn-outline-secondary">
                    Ver Faturas
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-corp mb-0">
                    <thead>
                        <tr>
                            <th>NF / Comp.</th>
                            <th>Fornecedor / Contrato</th>
                            <th class="text-end">Contratado</th>
                            <th class="text-end">Cobrado</th>
                            <th>Auditoria</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fat in Model.FaturasRecentesAuditoria)
                        {
                            <tr class="@(fat.PossuiDesvio ? "table-danger bg-opacity-10" : "")">
                                <td>
                                    <div class="fw-bold">@fat.NumeroNotaFiscal</div>
                                    <div class="small text-muted">@fat.Competencia</div>
                                </td>
                                <td title="@fat.FornecedorNome (@fat.NumeroContrato)">
                                    <div class="fw-semibold text-nowrap-ellipsis" style="max-width: 190px;">@fat.FornecedorNome</div>
                                    <div class="small text-muted">@fat.NumeroContrato</div>
                                </td>
                                <td class="text-end text-secondary">@fat.ValorContratado.ToString("C2")</td>
                                <td class="text-end fw-bold @(fat.PossuiDesvio ? "text-danger" : "")">@fat.ValorCobrado.ToString("C2")</td>
                                <td>
                                    @if (fat.PossuiDesvio)
                                    {
                                        <span class="badge badge-terracotta" title="Desvio de @fat.ValorDesvio.ToString("C2")">
                                            <i class="bi bi-exclamation-circle-fill me-1"></i>+@fat.PorcentagemDesvio.ToString("N1")% (@fat.ValorDesvio.ToString("C2"))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                            <i class="bi bi-check2-circle me-1"></i>Conforme
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const labelsMeses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LabelsEvolucao12Meses));
            const valoresContratados = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ValoresContratados12Meses));
            const valoresCobrados = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ValoresCobrados12Meses));

            const ctxEvolucao = document.getElementById('chartEvolucaoGastos');
            if (ctxEvolucao) {
                new Chart(ctxEvolucao, {
                    type: 'bar',
                    data: {
                        labels: labelsMeses,
                        datasets: [
                            {
                                label: 'Valor Homologado em Contrato (R$)',
                                data: valoresContratados,
                                backgroundColor: '#004d5d',
                                borderRadius: 6,
                                barPercentage: 0.65
                            },
                            {
                                label: 'Valor Faturado / Cobrado (R$)',
                                data: valoresCobrados,
                                backgroundColor: function(context) {
                                    const idx = context.dataIndex;
                                    if (valoresCobrados[idx] > valoresContratados[idx]) {
                                        return '#b6462e'; // Terracotta Red quando há desvio acima do contratado
                                    }
                                    return '#007889'; // Vibrant Teal quando conforme
                                },
                                borderRadius: 6,
                                barPercentage: 0.65
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top' }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function (value) {
                                        return 'R$ ' + value.toLocaleString('pt-BR');
                                    }
                                }
                            }
                        }
                    }
                });
            }

            const labelsFornecedores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LabelsTopFornecedores));
            const valoresFornecedores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ValoresTopFornecedores));

            const ctxForn = document.getElementById('chartTopFornecedores');
            if (ctxForn) {
                new Chart(ctxForn, {
                    type: 'doughnut',
                    data: {
                        labels: labelsFornecedores,
                        datasets: [{
                            data: valoresFornecedores,
                            backgroundColor: [
                                '#004d5d',
                                '#007889',
                                '#f69f3a',
                                '#b6462e',
                                '#606060'
                            ],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '62%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { boxWidth: 12, font: { size: 11 } }
                            }
                        }
                    }
                });
            }
        })();
    </script>
}
